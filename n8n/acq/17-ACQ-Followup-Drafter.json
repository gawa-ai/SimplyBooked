      "id": "fb1337d9-8949-53c7-bf5f-165e4a08dbb0",
      "name": "Mark Follow-up Failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1380,
        220
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_postgres",
          "name": "BOS Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The database rejects unsafe drafts (links, placeholders, stop conditions) by raising; the node passes it on as { error }.\nconst x = $('Parse Follow-up').item.json;\nconst saved = !$json.error && ($json.r || {}).ok === true;\nreturn { json: { followup_id: x.followup_id, saved: saved ? 'yes' : 'no',\n  error: saved ? '' : ('db_rejected_followup: ' + String($json.error?.message || $json.error || 'unknown').slice(0, 150)) } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "9129bb2b-0988-57d8-9e34-98c8957d2342",
      "name": "Check Follow-up Save",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1610,
        20
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "253dc415-ce2b-5556-a040-932af1b483ab",
                    "leftValue": "={{ $json.saved }}",
                    "rightValue": "yes",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "saved"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "0245583b-ec14-50c2-8d19-028ea3a4fdd6",
                    "leftValue": "={{ $json.saved }}",
                    "rightValue": "no",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
