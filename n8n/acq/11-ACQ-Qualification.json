      "id": "29a8da87-8baa-5bb9-8119-f6aabaa28549",
      "name": "AI Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1180,
        100
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_openai",
          "name": "BOS OpenAI"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const x = $('Extract Signals').item.json;\nconst res = $json;\nlet result = null, error = '';\nif (res.statusCode !== 200) {\n  error = 'openai_http_' + (res.statusCode ?? 'none') + ' ' + String((res.body && res.body.error && res.body.error.message) || '').slice(0, 150);\n} else {\n  try {\n    const content = res.body.choices[0].message.content;\n    result = JSON.parse(content);\n    const sc = result && typeof result === 'object' ? Number(result.score) : NaN;\n    if (!Number.isFinite(sc)) { error = 'ai_json_missing_score'; result = null; }\n    else if (sc < 0 || sc > 100) { error = 'ai_score_out_of_range'; result = null; }\n  } catch (e) { error = 'ai_json_unparseable'; result = null; }\n}\nreturn { json: { lead_id: x.lead_id, ok: result ? 'yes' : 'no', error,\n  result: result ? { ...result, signals: x.signals } : {}, model: x.model, prompt_version: x.prompt_version } };\n",
        "mode": "runOnceForEachItem"
      },
