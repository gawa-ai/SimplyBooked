    {
      "parameters": {
        "jsCode": "const x = $('Parse Classification').item.json;\nconst saved = !$json.error && ($json.r || {}).ok === true;\nreturn { json: { reply_id: x.reply_id, saved: saved ? 'yes' : 'no', error: saved ? '' : ('db_rejected: ' + String($json.error?.message || $json.error || 'unknown').slice(0, 150)) } };",
        "mode": "runOnceForEachItem"
      },
      "id": "59dc04a8-d323-5136-aa76-2ddac1f8b78c",
      "name": "Check Apply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1610,
        20
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "23030894-d103-5db9-afa1-b30af06b5c72",
                    "leftValue": "={{ $json.saved }}",
                    "rightValue": "yes",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "applied"
