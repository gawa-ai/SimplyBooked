    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $('Inbound SMS').item.json.r;\nconst agentText = typeof $json.output === 'string' ? $json.output.trim() : '';\nlet body = agentText || r.sms?.body || r.fallback_reply;\nif (body.length > 640) body = body.slice(0, 637) + '...';\nreturn { json: { business_id: r.business_id, to: r.from, from: r.to, account_sid: r.account_sid, body } };\n"
      },
      "id": "86e4b90c-1dd4-5160-9c34-393c9adfceec",
      "name": "Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $json.account_sid }}/Messages.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twilioApi",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "To",
              "value": "={{ $json.to }}"
            },
            {
              "name": "From",
              "value": "={{ $json.from }}"
            },
            {
              "name": "Body",
              "value": "={{ $json.body }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 20000
        }
      },
      "id": "8ff1d22f-1196-5512-b527-a0c2214dfb71",
      "name": "Send Reply SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1420,
        100
      ],
      "credentials": {
        "twilioApi": {
          "id": "REPLACE_twilio",
          "name": "BOS Twilio"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select bos.log_outbound($1::uuid, $2, $3, $4, $5, $6::int) as result;",
        "options": {
          "queryReplacement": "={{ [ $('Build Reply').item.json.business_id, $('Build Reply').item.json.to, $('Build Reply').item.json.from, $('Build Reply').item.json.body, $json.body?.sid ?? '', $json.statusCode ?? 0 ] }}",
          "queryBatching": "independently"
        }
      },
      "id": "b59c7ac1-bf75-52e6-97c9-f0ddf1de1573",
      "name": "Log Reply",
