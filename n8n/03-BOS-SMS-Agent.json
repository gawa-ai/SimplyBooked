    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Cancel this customer's booking. Only when the customer clearly asked to cancel.",
        "operation": "executeQuery",
        "query": "select bos.dispatch($1, 'cancel', $2::jsonb, $3, 'sms', $4::jsonb)::text as result;",
        "options": {
          "queryReplacement": "={{ [ $('Inbound SMS').item.json.r.business_id, { ref: $fromAI('ref', 'Booking reference if the customer has more than one booking, else empty', 'string', ''), reason: $fromAI('reason', 'Short reason if given, else empty', 'string', '') }, $('Inbound SMS').item.json.r.idem_prefix + ':cancel', { caller_phone: $('Inbound SMS').item.json.r.from } ] }}"
        }
      },
      "id": "2b38b735-e335-5891-a3d4-75b9513deec5",
      "name": "cancel_appointment",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
