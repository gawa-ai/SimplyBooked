    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Check open appointment times for a service on a date. Always use before offering or booking a time.",
        "operation": "executeQuery",
        "query": "select bos.dispatch($1, 'check_availability', $2::jsonb, $3, 'sms', $4::jsonb)::text as result;",
        "options": {
          "queryReplacement": "={{ [ $('Inbound SMS').item.json.r.business_id, { service: $fromAI('service', 'Service name as listed under SERVICES', 'string'), date: $fromAI('date', 'Date as YYYY-MM-DD in the business timezone', 'string'), time: $fromAI('time', 'Preferred time as HH:MM (24h), or empty to list openings that day', 'string', '') }, $('Inbound SMS').item.json.r.idem_prefix + ':check_availability', { caller_phone: $('Inbound SMS').item.json.r.from } ] }}"
        }
      },
      "id": "68b35891-108a-5c13-b3ad-3d42e7624c5d",
      "name": "check_availability",
      "type": "n8n-nodes-base.postgresTool",
      "typeVersion": 2.5,
      "position": [
        1040,
        460
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_postgres",
          "name": "BOS Postgres"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Book an appointment for this customer (their phone number is added automatically). Only after check_availability showed the time is free and the customer agreed.",
        "operation": "executeQuery",
        "query": "select bos.dispatch($1, 'book', $2::jsonb, $3, 'sms', $4::jsonb)::text as result;",
        "options": {
          "queryReplacement": "={{ [ $('Inbound SMS').item.json.r.business_id, { customer_name: $fromAI('customer_name', 'Customer full name', 'string'), service: $fromAI('service', 'Service name as listed under SERVICES', 'string'), date: $fromAI('date', 'Date as YYYY-MM-DD', 'string'), time: $fromAI('time', 'Time as HH:MM (24h)', 'string'), notes: $fromAI('notes', 'Optional short note for the team, or empty', 'string', '') }, $('Inbound SMS').item.json.r.idem_prefix + ':book', { caller_phone: $('Inbound SMS').item.json.r.from } ] }}"
        }
      },
      "id": "612d6ccb-e205-5d41-bda1-7739e0c8ba44",
      "name": "book_appointment",
