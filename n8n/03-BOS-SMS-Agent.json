        "postgres": {
          "id": "REPLACE_postgres",
          "name": "BOS Postgres"
        }
      }
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Move this customer's existing booking to a new date and time. Check availability first.",
        "operation": "executeQuery",
        "query": "select bos.dispatch($1, 'reschedule', $2::jsonb, $3, 'sms', $4::jsonb)::text as result;",
        "options": {
          "queryReplacement": "={{ [ $('Inbound SMS').item.json.r.business_id, { ref: $fromAI('ref', 'Booking reference if the customer has more than one booking, else empty', 'string', ''), date: $fromAI('date', 'New date as YYYY-MM-DD', 'string'), time: $fromAI('time', 'New time as HH:MM (24h)', 'string') }, $('Inbound SMS').item.json.r.idem_prefix + ':reschedule', { caller_phone: $('Inbound SMS').item.json.r.from } ] }}"
        }
      },
      "id": "5fcc3a55-cf74-54e9-aeef-8d61f7e28831",
      "name": "reschedule_appointment",
