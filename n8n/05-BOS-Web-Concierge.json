    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const g = $('Gate').item.json.g;\nconst body = $('Concierge Webhook').item.json.body || {};\nconst direct = g.allowed !== true || g.cached === true;\nlet reply = direct ? String(g.reply || '') : (typeof $json.output === 'string' ? $json.output.trim() : '');\nconst gotAnswer = !direct && !!reply;\nif (!reply) reply = 'Sorry, I had trouble with that. Please try again in a moment.';\nif (reply.length > 700) reply = reply.slice(0, 697) + '...';\n// Only static FAQ-style answers are cached: first turn, nothing about bookings, dates or the visitor.\nconst bookingish = /\\b(book|booking|cancel|resched|move|change|available|availability|slot|appointment|tomorrow|today|tonight|next|monday|tuesday|wednesday|thursday|friday|saturday|sunday|ref|reference|my name|i am|i'm)\\b/i;\nconst cacheable = gotAnswer && Number(body.turn) === 1 && !bookingish.test(String(body.message || ''));\nreturn { json: { reply, cached: g.cached === true, business_id: g.business_id || '', message: String(body.message || ''), cacheable } };\n"
      },
      "id": "7892fdb9-1050-57c9-b179-e31394f4f683",
      "name": "Build Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        100
      ]
    },
