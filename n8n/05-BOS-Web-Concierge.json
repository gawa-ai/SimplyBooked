    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Check open appointment times for a service on a date. Always use before offering or booking a time.",
        "operation": "executeQuery",
        "query": "select bos.dispatch($1, 'check_availability', $2::jsonb, $3, 'website', $4::jsonb)::text as result;",
        "options": {
          "queryReplacement": "={{ [ $('Concierge Webhook').item.json.body.business, { service: $fromAI('service', 'Service name as listed under SERVICES', 'string'), date: $fromAI('date', 'Date as YYYY-MM-DD in the business timezone', 'string'), time: $fromAI('time', 'Preferred time as HH:MM (24h), or empty to list openings that day', 'string', '') }, String($('Concierge Webhook').item.json.body.session || 'anon').replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 40) + ':check_availability', '{}' ] }}"
        }
      },
