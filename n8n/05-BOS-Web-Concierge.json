    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Book an appointment after the visitor agreed to a free time shown by check_availability and gave name and mobile number.",
        "operation": "executeQuery",
        "query": "select bos.dispatch($1, 'book', $2::jsonb, $3, 'website', $4::jsonb)::text as result;",
        "options": {
          "queryReplacement": "={{ [ $('Concierge Webhook').item.json.body.business, { customer_name: $fromAI('customer_name', 'Visitor full name', 'string'), phone: $fromAI('phone', 'Visitor mobile number', 'string'), service: $fromAI('service', 'Service name as listed under SERVICES', 'string'), date: $fromAI('date', 'Date as YYYY-MM-DD', 'string'), time: $fromAI('time', 'Time as HH:MM (24h)', 'string'), notes: $fromAI('notes', 'Optional short note for the team, or empty', 'string', '') }, String($('Concierge Webhook').item.json.body.session || 'anon').replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 40) + ':book', '{}' ] }}"
        }
